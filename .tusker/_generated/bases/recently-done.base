filters:
  and:
    - file.ext == "md"
    - 'schema == "tusker.task/v7"'
properties:
  id:
    displayName: ID
  title:
    displayName: Title
  epic:
    displayName: Epic
  status:
    displayName: Status
  readiness:
    displayName: Readiness
  priority:
    displayName: Priority
  next_owner:
    displayName: Next owner
  next_action:
    displayName: Next action
views:
  - type: table
    name: "Recently Done"
    filters:
      and:
        - 'status == "done"'
    order: [id, title, epic, accepted_by, closed_at]
